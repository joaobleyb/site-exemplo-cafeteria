# Copie para .env e ajuste.
PORT=3000
NODE_ENV=development

# Senha única da equipe para entrar em /painel. Obrigatória em produção.
STAFF_PASSWORD=troque-esta-senha

# Chave que assina a sessão do painel. Use um texto longo e aleatório em produção.
# Sem ela, uma chave nova é criada a cada reinício e a equipe precisa entrar de novo.
SESSION_SECRET=

# Use 1 quando o servidor estiver atrás de um proxy (hospedagem), para o limite de tentativas ver o IP real.
TRUST_PROXY=0

# Pasta do banco SQLite. Padrão: ./data
# DATA_DIR=./data
